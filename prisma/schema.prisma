// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  date        DateTime
  location    String?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  position    String
  imageUrl    String?
  linkedin    String?
  department  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_members")
}

model ClubLead {
  id          String   @id @default(cuid())
  name        String
  role        String   // "Lead" or "Co-Lead"
  title       String?  // Optional title like "President", "Vice President", etc.
  bio         String?
  imageUrl    String?
  linkedin    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("club_leads")
}